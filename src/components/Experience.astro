---
import Icon from './Icon.astro';
import { experience } from '../data/profile';
---
<section class="exp" id="experiencia">
  <h2>Experiencia</h2>
  <ol class="timeline">
    {experience.map((c) => (
      <li class="company" id={c.icon}>
        <span class="logo"><Icon name={c.icon} size={27} /></span>
        {c.roles.map((r) => (
          <article class="role">
            <header>
              <div>
                <h3>{r.title}</h3>
                <p class="meta">{c.name} <span>•</span> {r.type}</p>
              </div>
              <time>{r.period}</time>
            </header>
            {r.summary && <p class="summary">{r.summary}</p>}
            {r.bullets && (
              <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
            )}
          </article>
        ))}
      </li>
    ))}
  </ol>
</section>

<style>
  .exp { width: 100%; max-width: 620px; margin: 0 auto; }
  h2 {
    font-weight: 500;
    font-size: 30px;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
  }
  .timeline { list-style: none; margin: 0; padding: 0; }
  .company {
    position: relative;
    padding-left: 44px;
    padding-bottom: 8px;
  }
  .company::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 34px;
    bottom: 6px;
    width: 1px;
    background: var(--line);
  }
  .company:last-child::before { display: none; }
  .logo {
    position: absolute;
    left: 0;
    top: 2px;
    width: 27px;
    height: 27px;
    border-radius: 6px;
    overflow: hidden;
    color: var(--lisar);
  }
  .logo :global(svg) { display: block; }
  .role { padding-bottom: 28px; }
  header { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; }
  h3 {
    font-weight: 500;
    font-size: 17px;
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.2;
  }
  .meta { margin: 2px 0 0; font-size: 13px; color: var(--muted); }
  .meta span { margin: 0 4px; font-size: 9px; }
  time { flex: none; font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
  .summary { margin: 12px 0 0; font-size: 14px; line-height: 1.6; color: var(--ink-2); max-width: 460px; }
  ul { margin: 10px 0 0; padding-left: 16px; font-size: 13px; line-height: 1.7; color: var(--ink-2); }
  ul li::marker { color: var(--muted); }
  @media (max-width: 560px) {
    header { flex-direction: column; gap: 4px; }
    h2 { font-size: 26px; }
  }
</style>
