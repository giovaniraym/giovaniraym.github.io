---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const work = [
  { label: 'Retalio', icon: 'retalio', href: '#retalio' },
  { label: 'uSafety', icon: 'usafety', href: '#usafety' },
  { label: 'Hilton Monterrey', icon: 'hilton-mty', href: '#hilton-mty' },
  { label: 'Hilton Cancún', icon: 'hilton-cancun', href: '#hilton-cancun' },
  { label: 'Lisar', icon: 'lisar', href: '#lisar', inset: true },
];
const social = [
  { label: 'GitHub', icon: 'github', href: profile.github, bg: 'var(--gh-bg)', fg: 'var(--gh-fg)' },
  { label: 'LinkedIn', icon: 'linkedin', href: profile.linkedin, bg: '#2d6db5', fg: '#fff' },
  { label: 'Email', icon: 'mail', href: `mailto:${profile.email}`, bg: 'linear-gradient(180deg,#5ab0ff,#1f7cf2)', fg: '#fff' },
];
---
<nav class="dock" aria-label="Accesos">
  <div class="group">
    {work.map((a) => (
      <a class="app" href={a.href} aria-label={a.label}>
        <span class:list={['logo', { inset: a.inset }]}><Icon name={a.icon} size={44} /></span>
        <span class="tip">{a.label}</span>
      </a>
    ))}
  </div>
  <span class="divider"></span>
  <div class="group">
    {social.map((a) => (
      <a class="app" href={a.href} style={`--bg:${a.bg};--fg:${a.fg}`} aria-label={a.label} target={a.href.startsWith('http') ? '_blank' : undefined} rel="noopener" data-copy={a.href.startsWith('mailto:') ? profile.email : undefined}>
        <Icon name={a.icon} />
        <span class="tip">{a.label}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .dock {
    --tile: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 18px;
    background: var(--dock);
    border: 1px solid var(--dock-line);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.08), 0 1px 2px rgb(0 0 0 / 0.06);
    backdrop-filter: blur(12px);
  }
  .app {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: var(--tile);
    height: var(--tile);
    border-radius: calc(var(--tile) / 4);
    background: var(--bg, var(--card-hover));
    color: var(--fg, var(--lisar));
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06), 0 1px 2px rgb(0 0 0 / 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .app:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06), 0 6px 14px rgb(0 0 0 / 0.18); }
  .logo {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
  }
  .logo :global(svg), .logo :global(img), .app > :global(svg) { display: block; width: 100%; height: 100%; }
  .logo.inset { padding: 18%; }
  .app > :global(svg) { width: 50%; height: 50%; }
  .group { display: flex; gap: 6px; }
  .divider { flex: none; width: 1px; height: 32px; margin: 0 4px; background: var(--line); }
  @media (orientation: landscape) and (min-width: 641px) and (max-width: 1180px) and (max-height: 820px) {
    .dock { --tile: clamp(28px, calc((46vw - 112px) / 8), 44px); gap: 5px; padding: 5px; border-radius: calc(var(--tile) / 4 + 5px); }
    .group { gap: 5px; }
    .divider { height: calc(var(--tile) * 0.7); margin: 0 2px; }
  }
  .tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    translate: -50% 4px;
    padding: 3px 8px;
    border-radius: 6px;
    background: #1d1d1f;
    color: #fff;
    font-size: 11px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s, translate 0.15s;
  }
  .app:hover .tip { opacity: 1; translate: -50% 0; }
</style>
